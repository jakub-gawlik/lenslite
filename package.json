{
  "name": "lenslite",
  "version": "0.1.0",
  "description": "Mobile-first, dependency-free lightbox gallery with full gesture support",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run typecheck && npm run test:coverage && npm run build"
  },
  "keywords": [
    "lightbox",
    "gallery",
    "photo",
    "image-viewer",
    "gestures",
    "touch",
    "pinch-zoom",
    "typescript"
  ],
  "author": "Jakub Gawlik <info@caasi.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakub-gawlik/lenslite.git"
  },
  "bugs": "https://github.com/jakub-gawlik/lenslite/issues",
  "homepage": "https://github.com/jakub-gawlik/lenslite#readme",
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
