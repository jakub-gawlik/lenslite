{
  "name": "lenslite",
  "version": "0.1.0",
  "description": "Mobile-first, dependency-free lightbox gallery with full gesture support",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lenslite.css": "./dist/lenslite.css",
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/lenslite.min.js",
  "jsdelivr": "./dist/lenslite.min.js",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && node scripts/build.mjs && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "size": "size-limit",
    "changeset": "changeset",
    "release": "changeset publish",
    "prepublishOnly": "npm run typecheck && npm run test:coverage && npm run build && npm run size"
  },
  "keywords": [
    "lightbox",
    "gallery",
    "photo",
    "image-viewer",
    "gestures",
    "touch",
    "pinch-zoom",
    "typescript"
  ],
  "author": "Jakub Gawlik <info@caasi.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakub-gawlik/lenslite.git"
  },
  "bugs": "https://github.com/jakub-gawlik/lenslite/issues",
  "homepage": "https://lenslite.art",
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.64.1",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "size-limit": "^14.2.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
